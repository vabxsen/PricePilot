rules_version = '2';

// PricePilot Firestore security model (Spark MVP).
// - Users may read/write ONLY their own data under users/{uid}.
// - products/** is world-readable (public price history) but writable
//   only by the Admin SDK (the scraper) — never by clients.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid);

      // `username` may be set exactly once and never changed again after
      // that. usernames/{name} below is the actual global-uniqueness
      // guarantee; this just enforces "once set, forever set" server-side
      // (not just in the client UI) so a direct API call can't bypass it.
      allow update: if isOwner(uid) && (
        resource.data.get('username', '') == '' ||
        request.resource.data.username == resource.data.username
      );
      allow delete: if false;

      match /trackers/{trackerId} {
        allow read, write: if isOwner(uid);
      }
      match /wishlist/{itemId} {
        // Saved-but-not-tracked products; fully owner-private.
        allow read, write: if isOwner(uid);
      }
      match /notifications/{notifId} {
        // Clients can read/dismiss; the scraper writes via Admin SDK (bypasses rules).
        allow read, update, delete: if isOwner(uid);
        allow create: if false;
      }
    }

    // usernames/{lowercasedUsername} — one doc per claimed username, doc ID
    // is the lowercase-normalized name. Reserving a doc here is what
    // actually guarantees global uniqueness (Firestore document creation is
    // atomic): whoever's `create` lands first wins, and since the doc then
    // exists, every subsequent attempt at the same ID is evaluated as an
    // `update`, which is denied below — so a claim can never be reassigned
    // or released.
    match /usernames/{username} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
        && username.matches('^[a-z0-9_]{3,20}$');
      allow update, delete: if false;
    }

    match /products/{productId} {
      allow read: if true;

      // A signed-in user may bootstrap a brand-new product doc when adding
      // a tracker (seeded from the resolver's preview) — but every write
      // after that (price, stock, history, all-time stats) is Admin SDK
      // (the scraper) only, so users can never falsify price history.
      allow create: if isSignedIn()
        && request.resource.data.trackerCount == 1
        && request.resource.data.keys().hasAll([
          'id', 'title', 'retailer', 'url', 'currency',
          'currentPrice', 'inStock', 'trackerCount', 'checkInterval', 'createdAt'
        ]);

      // The only client-side update allowed on an existing product is
      // trackerCount moving by exactly +/-1 (tracking/untracking).
      allow update: if isSignedIn() && (
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['trackerCount'])
          && request.resource.data.trackerCount == resource.data.trackerCount + 1)
        ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['trackerCount'])
          && request.resource.data.trackerCount == resource.data.trackerCount - 1)
      );

      allow delete: if false;

      match /history/{pointId} {
        allow read: if true;
        allow write: if false; // Admin SDK only
      }
    }
  }
}
